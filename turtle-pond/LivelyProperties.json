{
  "_comment": "Lively 设置面板。品种数量由 species 字段控制（见下），此处暴露常用项。",
  "_saveComment": "存档：龟/鱼/植物/螺虾/蛋/昼夜/天气的完整状态自动保存（30秒一次 + 关闭时一次），关掉壁纸再打开即继续上次的水塘。",
  "saveEnabled": {
    "type": "checkbox",
    "text": "存档：记住水塘状态（关掉再打开继续）",
    "value": true
  },
  "resetPond": {
    "type": "checkbox",
    "text": "重新开始（清空存档，从新水塘开始）",
    "value": false
  },
  "fishCount": {
    "type": "slider",
    "text": "小鱼总数",
    "value": 14,
    "min": 0,
    "max": 60,
    "step": 1
  },
  "turtleCount": {
    "type": "slider",
    "text": "乌龟总数",
    "value": 2,
    "min": 0,
    "max": 6,
    "step": 1
  },
  "duckweedCount": {
    "type": "slider",
    "text": "浮萍密度",
    "value": 60,
    "min": 0,
    "max": 200,
    "step": 5
  },
  "waterTop": {
    "type": "color",
    "text": "水面颜色（上）",
    "value": "#4a8fa8"
  },
  "waterBottom": {
    "type": "color",
    "text": "水底颜色（下）",
    "value": "#1e4a5f"
  },
  "quality": {
    "type": "dropdown",
    "text": "画质",
    "value": "balanced",
    "items": ["eco", "balanced", "detail"]
  },
  "showFps": {
    "type": "checkbox",
    "text": "显示帧率",
    "value": true
  },
  "showPlants": {
    "type": "checkbox",
    "text": "显示植物（睡莲/芦苇/水草）",
    "value": true
  },
  "daynightEnabled": {
    "type": "checkbox",
    "text": "昼夜循环（8分钟一天）",
    "value": true
  },
  "dayLength": {
    "type": "slider",
    "text": "一天时长（秒）",
    "value": 480,
    "min": 60,
    "max": 1800,
    "step": 30
  },
  "weatherEnabled": {
    "type": "checkbox",
    "text": "天气系统（晴/小雨/雨后）",
    "value": true
  },
  "fxEnabled": {
    "type": "checkbox",
    "text": "视觉打磨（阴影/景深/水面光斑）",
    "value": true
  },
  "audioEnabled": {
    "type": "checkbox",
    "text": "音效（默认关闭，避免打扰）",
    "value": false
  },
  "masterVolume": {
    "type": "slider",
    "text": "音量",
    "value": 0.35,
    "min": 0,
    "max": 1,
    "step": 0.05
  },
  "frogSound": {
    "type": "checkbox",
    "text": "夜晚蛙鸣",
    "value": true
  },
  "species": {
    "_comment": "品种配置：key=品种 id，value=数量。改这里即可自定义水塘物种组成。",
    "fish": {
      "crucian": 4,
      "koi": 2,
      "grasscarp": 2,
      "whitebait": 3,
      "goldfish": 2,
      "gambusia": 1
    },
    "turtle": {
      "redear": 1,
      "chinese": 1
    }
  }
}
