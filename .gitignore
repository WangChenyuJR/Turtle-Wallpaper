# ── 大体积安装包（不入库）──
_downloads/

# ── Python 虚拟环境 ──
.venv/
__pycache__/
*.pyc

# ── WorkBuddy 会话数据 ──
.workbuddy/

# ── 临时与调试产物 ──
_shot.png
_*.png
_*.txt
_*.log
_*.html.bak

# 一次性调试脚本与无头浏览器输出（不可复现流程，勿入库）
turtle-pond/_dump_out.html
turtle-pond/_style_probe.html
turtle-pond/_shot_*.html

# 例外：风格测试页的备选稿截图是正式资产（上面 _*.png 规则的反向豁免）
!turtle-pond/_cute_*.png
!turtle-pond/_style_rows_*.png
!turtle-pond/_style_row_*.png

# ── 参考素材（用户提供的第三方图片，仅作风格分析，不入库）──
ref-turtle-cartoon/

# ── AI 生成过程产物（体积大，不入库；成品部件已单独入库）──
# _gen/ 存放重生成用的姿势图原图与旧图备份；turtle-cute-portraits* 是立绘看板及其 53MB 生成历史
turtle-pond/_gen/
turtle-cute-portraits_assets/
turtle-cute-portraits.miora

# ── 编辑器与系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 测试输出与调试探针 ──
_test_*_out.html
_probe.html
